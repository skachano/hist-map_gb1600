{
  "additionalProperties": false,
  "properties": {
    "source_page": {
      "anyOf": [
        {
          "pattern": "^\\d{1,3}(?:-\\d{1,3})?(?:;\\s*\\d{1,3}(?:-\\d{1,3})?)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Page"
    },
    "confidence": {
      "default": "high",
      "title": "Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "from_year": {
      "anyOf": [
        {
          "maximum": 1800,
          "minimum": 1000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "From Year"
    },
    "to_year": {
      "anyOf": [
        {
          "maximum": 1800,
          "minimum": 1000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To Year"
    },
    "from_precision": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "exact",
            "circa",
            "before",
            "after",
            "attested"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "From Precision"
    },
    "to_precision": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "exact",
            "circa",
            "before",
            "after",
            "attested"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "To Precision"
    },
    "child_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Child Id",
      "type": "string"
    },
    "parent_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Parent Id",
      "type": "string"
    },
    "is_disputed": {
      "default": false,
      "title": "Is Disputed",
      "type": "boolean"
    }
  },
  "required": [
    "child_id",
    "parent_id"
  ],
  "title": "memberships",
  "type": "object"
}
